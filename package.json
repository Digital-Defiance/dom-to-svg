{
  "name": "dom-to-svg",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Inspect a DOM element and convert it to a true-vector SVG",
  "files": [
    "manifest.json",
    "icons/",
    "src/background.js",
    "dist/inject.js"
  ],
  "scripts": {
    "build": "esbuild src/inject.js --bundle --format=iife --target=es2022 --outfile=dist/inject.js",
    "build:watch": "npm run build -- --watch",
    "pack:store": "node scripts/pack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:browser": "vitest run tests/browser",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.51.0",
    "vitest": "^3.0.0"
  }
}
